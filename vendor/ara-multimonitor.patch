+/** One physical monitor, in the RDP coordinate space. Right/bottom are inclusive. */
+export type MonitorRect = {
+    left: number;
+    top: number;
+    right: number;
+    bottom: number;
+    primary?: boolean;
+};
+
+/**
+ * Advertise a multi-monitor layout ([MS-RDPBCGR] 2.2.1.3.6 TS_UD_CS_MONITOR).
+ *
+ * Without this the server sees one screen the size of the whole desktop, so maximizing a window
+ * covers every monitor and the taskbar stretches across all of them. With it, the server knows
+ * where the seams are and behaves per monitor.
+ *
+ * Coordinates are relative to the primary monitor's top-left, so the primary is at `(0, 0)` and
+ * monitors to its left/above have negative `left`/`top`. The desktop size passed to
+ * `SessionBuilder.desktopSize()` must be the bounding box of these rectangles.
+ *
+ * Invalid layouts are rejected on the Rust side and logged, leaving the session single-monitor —
+ * a bad layout makes the server drop the connection during the handshake with no useful error.
+ */
+export function monitorLayout(monitors: MonitorRect[]): Extension {
+    const flat: number[] = [];
+    for (const m of monitors) {
+        flat.push(m.left, m.top, m.right, m.bottom, m.primary ? 1 : 0);
+    }
+    return new Extension('monitors', flat);
+}
