    "@tiptap/starter-kit": "3.31.3",
    "@vscode/ripgrep-universal": "1.18.0",
    "@xterm/addon-fit": "0.12.0-beta.301",
    "@xterm/addon-image": "0.10.0-beta.301",
    "@xterm/addon-search": "0.17.0-beta.301",
    "@xterm/addon-unicode11": "0.10.0-beta.301",
    "@xterm/addon-web-links": "0.13.0-beta.301",
    "@xterm/addon-webgl": "0.20.0-beta.300",
    "@xterm/headless": "6.1.0-beta.303",
    "@xterm/xterm": "6.1.0-beta.304",
    "dompurify": "3.4.17",
    "electron-updater": "^6.8.9",
    "js-yaml": "4.3.1",
    "lucide-react": "^1.31.0",
    "marked": "^17.0.6",
    "mermaid": "^11.17.2",
    "monaco-editor": "0.55.1",
    "node-pty": "^1.1.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.5.0",
    "ssh2": "^1.17.0",
    "vscode-oniguruma": "^2.0.1",
    "ws": "^8.21.2",
    "zod": "4.4.3",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "43.8.6",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.0"
  }
