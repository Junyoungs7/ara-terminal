+/// Parse the flat `[left, top, right, bottom, primary, ...]` array from the `monitors` extension.
+///
+/// Validation mirrors [MS-RDPBCGR] 2.2.1.3.6 so a bad layout fails here instead of getting the
+/// connection rejected mid-handshake (the server just drops us, with no useful error):
+///  - at most 16 monitors, at least one
+///  - exactly one primary, and the primary must sit at the origin
+///  - each monitor between 200x200 and 8192x8192
+fn parse_monitor_layout(value: &JsValue) -> Result<Vec<ironrdp::pdu::gcc::Monitor>, String> {
+    use ironrdp::pdu::gcc::{Monitor, MonitorFlags};
+
+    const FIELDS: usize = 5;
+    const MAX_MONITORS: usize = 16;
+    const MIN_EDGE: i32 = 200;
+    const MAX_EDGE: i32 = 8192;
+
+    let array = js_sys::Array::from(value);
+    let len = array.length() as usize;
+    if len == 0 || len % FIELDS != 0 {
+        return Err(format!("expected a flat array of {FIELDS} numbers per monitor, got {len}"));
+    }
+    let count = len / FIELDS;
+    if count > MAX_MONITORS {
+        return Err(format!("too many monitors: {count} (max {MAX_MONITORS})"));
+    }
+
+    let num = |i: usize| -> Result<i32, String> {
+        array
+            .get(i as u32)
+            .as_f64()
+            .map(|v| v as i32)
+            .ok_or_else(|| format!("element {i} is not a number"))
+    };
+
+    let mut monitors = Vec::with_capacity(count);
+    let mut primaries = 0usize;
+    for m in 0..count {
+        let base = m * FIELDS;
+        let (left, top, right, bottom) = (num(base)?, num(base + 1)?, num(base + 2)?, num(base + 3)?);
+        let is_primary = num(base + 4)? != 0;
+
+        let (width, height) = (right - left + 1, bottom - top + 1);
+        if !(MIN_EDGE..=MAX_EDGE).contains(&width) || !(MIN_EDGE..=MAX_EDGE).contains(&height) {
+            return Err(format!("monitor {m} is {width}x{height}, outside {MIN_EDGE}..={MAX_EDGE}"));
+        }
+        if is_primary {
+            primaries += 1;
+            if left != 0 || top != 0 {
+                return Err(format!("primary monitor must be at the origin, got ({left}, {top})"));
+            }
+        }
+
+        monitors.push(Monitor {
+            left,
+            top,
+            right,
+            bottom,
+            flags: if is_primary { MonitorFlags::PRIMARY } else { MonitorFlags::empty() },
+        });
+    }
+    if primaries != 1 {
+        return Err(format!("expected exactly one primary monitor, got {primaries}"));
     }
+    Ok(monitors)
 }
 
