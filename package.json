{
  "name": "ara",
  "productName": "A.R.A",
  "version": "0.1.1",
  "description": "A.R.A — AI Terminal",
  "author": "VERYGOOD",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "electron-vite build && electron tests/smoke-boot.cjs",
    "smoke:quitfail": "electron-vite build && node tests/quit-fail-smoke.cjs",
    "check:rdpwasm": "electron-vite build && electron tests/rdp-wasm-check.cjs",
    "stress": "electron-vite build && electron tests/stress-highbw.cjs",
    "screenshot": "electron-vite build && electron tests/screenshot.cjs",
    "screenshot:f3": "electron-vite build && electron tests/f3-screenshot.cjs",
    "screenshot:f5": "electron-vite build && electron tests/f5-screenshot.cjs",
    "f6:bundle": "node scripts/bundle-f6-harness.mjs",
    "e2e:f6": "electron-vite build && npm run f6:bundle && electron tests/f6-restore.cjs",
    "f7:bundle": "node scripts/bundle-f7-harness.mjs",
    "screenshot:f7": "electron-vite build && npm run f7:bundle && electron tests/f7-screenshot.cjs",
    "w1b:bundle": "node scripts/bundle-w1b-harness.mjs",
    "screenshot:w1b": "electron-vite build && npm run w1b:bundle && electron tests/w1b-screenshot.cjs",
    "screenshot:polish": "electron-vite build && electron tests/fix-polish-screenshot.cjs",
    "e2e:full": "electron-vite build && playwright test",
    "e2e:full:nobuild": "playwright test",
    "scan:magic": "node scripts/scan-magic-numbers.mjs",
    "scan:i18n": "node scripts/scan-i18n.mjs",
    "scan:push": "node scripts/scan-window-push.mjs",
    "fixdestroy:bundle": "node scripts/bundle-fixdestroy-harness.mjs",
    "smoke:fixdestroy": "npm run fixdestroy:bundle && electron tests/fix-destroyed-smoke.cjs",
    "shutdown:bundle": "node scripts/bundle-shutdown-harness.mjs",
    "smoke:shutdown": "npm run shutdown:bundle && node tests/shutdown-smoke.cjs",
    "w2:browser": "electron-vite build && electron tests/w2-browser.cjs",
    "w2:bundle": "node scripts/bundle-w2-harness.mjs",
    "screenshot:w2": "electron-vite build && npm run w2:bundle && electron tests/w2-screenshot.cjs",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "site:stage": "node scripts/stage-release.mjs",
    "site:deploy": "node scripts/deploy-site.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "screenshot:ux1": "electron-vite build && electron tests/fix-ux1-screenshot.cjs",
    "screenshot:r1": "electron-vite build && electron tests/r1-screenshot.cjs",
    "screenshot:r2": "electron-vite build && electron tests/r2-screenshot.cjs",
    "screenshot:r3": "electron-vite build && electron tests/r3-screenshot.cjs",
    "screenshot:r4": "electron-vite build && electron tests/r4-screenshot.cjs",
    "screenshot:r5r6": "electron-vite build && electron tests/r5r6-screenshot.cjs",
    "screenshot:r7r8": "electron-vite build && electron tests/r7r8-screenshot.cjs",
    "screenshot:w1c": "electron-vite build && electron tests/w1c-screenshot.cjs",
    "screenshot:w3": "electron-vite build && electron tests/w3-screenshot.cjs",
    "w4sat:bundle": "node scripts/bundle-w4sat-harness.mjs",
    "screenshot:w4sat-explorer": "electron-vite build && npm run w4sat:bundle && electron tests/w4sat-explorer-screenshot.cjs",
    "screenshot:w4sat-rdp": "electron-vite build && electron tests/w4sat-rdp-screenshot.cjs",
    "screenshot:f23": "electron-vite build && electron tests/f23-screenshot.cjs",
    "screenshot:w5": "electron-vite build && electron tests/w5-screenshot.cjs",
    "screenshot:fbmon": "electron-vite build && electron tests/fbmon-screenshot.cjs",
    "voice:model": "node scripts/fetch-wake-model.mjs",
    "icons:svg": "node scripts/make-brand-svg.mjs",
    "icons:png": "electron scripts/make-icon-png.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@devolutions/iron-remote-desktop-rdp": "file:vendor/iron-remote-desktop-rdp",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.31.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0",
    "vosk-browser": "^0.0.8",
    "ws": "^8.21.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
